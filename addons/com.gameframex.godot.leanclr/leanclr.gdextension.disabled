[configuration]

entry_symbol = "leanclr_godot_library_init"
compatibility_minimum = "4.4"

[libraries]

windows.debug.x86_64 = "res://addons/com.gameframex.godot.leanclr/bin/Debug/leanclr_godot.dll"
windows.release.x86_64 = "res://addons/com.gameframex.godot.leanclr/bin/Release/leanclr_godot.dll"
linux.debug.x86_64 = "res://addons/com.gameframex.godot.leanclr/bin/Debug/libleanclr_godot.so"
linux.release.x86_64 = "res://addons/com.gameframex.godot.leanclr/bin/Release/libleanclr_godot.so"
macos.debug = "res://addons/com.gameframex.godot.leanclr/bin/Debug/libleanclr_godot.dylib"
macos.release = "res://addons/com.gameframex.godot.leanclr/bin/Release/libleanclr_godot.dylib"
web.release.wasm32 = "res://addons/com.gameframex.godot.leanclr/bin/Release/libleanclr_godot.wasm"
