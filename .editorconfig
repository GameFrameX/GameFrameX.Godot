# csharp-braces：C# 控制流必须带大括号（~/.claude/rules/csharp-braces.md），构建期按错误处理
root = true

[*.cs]
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# 生态移植（vendored，不按本仓风格改造，整目录排除，参照 Server.Source 的 ProtoBuf.Net 做法）
[addons/**.cs]
csharp_prefer_braces = true:none
dotnet_diagnostic.IDE0011.severity = none
